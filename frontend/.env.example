# Local Vite development (optional). If unset, DEV mode uses http://localhost:5000/api.
VITE_API_BASE_URL=http://localhost:5000/api

# Production / Hostinger same-origin build: omit this variable so the app uses /api.
#
# Separate Vercel frontend deploy: set at build time to the backend API base
# (must end with /api), e.g.:
# VITE_API_BASE_URL=https://your-backend.vercel.app/api
