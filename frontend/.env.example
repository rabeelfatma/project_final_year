# Local Vite development (optional).
# If unset in DEV, the app uses http://<page-hostname>:5000/api so a phone opening
# the laptop's LAN IP still reaches the laptop backend (not the phone's localhost).
# VITE_API_BASE_URL=http://localhost:5000/api
# Optional override for the DEV API port when not using VITE_API_BASE_URL:
# VITE_DEV_API_PORT=5000

# Same-Wi-Fi mobile testing: either `npm run dev:lan` or set:
# VITE_LAN=1
# Then open http://<laptop-private-ip>:5173 on the phone. Both devices must be on
# the same LAN; Windows Firewall may need to allow Node/Vite. Do not port-forward
# the dev server to the public internet.

# Production / Hostinger same-origin build: omit VITE_API_BASE_URL so the app uses /api.
#
# Separate Vercel frontend deploy: set at build time to the backend API base
# (must end with /api). Use the real backend project URL from the Vercel dashboard —
# do not invent it:
# VITE_API_BASE_URL=https://your-backend.vercel.app/api
