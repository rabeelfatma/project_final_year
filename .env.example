# Local single-process entry (LOCKED by default).
# The deployed targets are two Vercel projects, not this file:
#   Frontend  https://quick-check-hub-frontend.vercel.app
#   API       https://quickcheck-hub-backend.vercel.app
# Set the API project's variables from backend/.env.example (Vercel section).
NODE_ENV=production
PORT=3000
APP_RUNTIME_MODE=maintenance

# Unlock the full academic application ONLY after MongoDB credentials
# and security acceptance. Exact value required:
# APP_RUNTIME_MODE=full

# Required on the Vercel API project when APP_RUNTIME_MODE=full
# (names only — set real values in the Vercel dashboard, never in Git):
# MONGO_URI=
# JWT_SECRET=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# VAPID_SUBJECT=mailto:your-email@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# RESEND_API_KEY=
# PASSWORD_RESET_FROM_EMAIL=
# PUBLIC_APP_URL is optional. Production defaults to
# https://quick-check-hub-frontend.vercel.app
# CLIENT_ORIGIN is optional. That same frontend origin is allowlisted in code.

# Cloudflare R2 — required for durable uploads on the Vercel API project.
# Leave unset for local disk uploads.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=quickcheck-hub-files
# R2_ENDPOINT=
