# Hostinger / production staging (LOCKED by default)
NODE_ENV=production
PORT=3000
APP_RUNTIME_MODE=maintenance

# Unlock the full academic application ONLY after Professor approval,
# MongoDB credentials, and security acceptance. Exact value required:
