PORT=5000
# Hostinger/npm start defaults to maintenance unless this is exactly "full".
# Local `npm run dev` sets full mode via dev-start.js automatically.
APP_RUNTIME_MODE=full
MONGO_URI=mongodb://127.0.0.1:27017/quickcheckhub
JWT_SECRET=replace-with-your-own-secret
# Gemini AI grading (server-only). Hostinger: set GEMINI_API_KEY in Node env.
# GOOGLE_API_KEY is accepted as a fallback. Never expose keys to the frontend.
GEMINI_API_KEY=your-gemini-api-key
# Model id from Google AI Studio for your project (change if unavailable).
GEMINI_MODEL=gemini-3.8-flash
# Used only to identify your web-push application.
VAPID_SUBJECT=mailto:your-email@example.com
# Hostinger/local: keys are auto-generated into backend/.vapid.json when missing.
# Vercel (read-only FS): set both explicitly — never rely on .vapid.json writes.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Separate Vercel SPA origin(s), comma-separated. Leave unset for Hostinger same-origin.
# CLIENT_ORIGIN=https://your-frontend.vercel.app
# FRONTEND_URL=

# Transactional email via Resend (password reset + signup verification + Admin notify).
# All server-only — never expose to the React bundle / Vite client.
# Leave unset locally to fail closed (503) until real delivery is configured.
#
# Production (duke.com.pk) — set these in Hostinger Node env (NOT in Git):
#   RESEND_API_KEY=<paste operator-saved key only in Hostinger panel / secret store>
#   PASSWORD_RESET_FROM_EMAIL=QuickCheck Hub <noreply@duke.com.pk>
#   PUBLIC_APP_URL=https://duke.com.pk
#   ADMIN_NOTIFY_EMAIL=rabeelramzan50@gmail.com
#
# RESEND_API_KEY=
# PASSWORD_RESET_FROM_EMAIL=QuickCheck Hub <noreply@duke.com.pk>
# PUBLIC_APP_URL=https://duke.com.pk
# ADMIN_NOTIFY_EMAIL=rabeelramzan50@gmail.com

# Academic upload storage root (optional). Default: backend/uploads.
# DB records keep relative paths like uploads/submissions/<file>.
# Hostinger container disk is NOT assumed durable across redeploy — mount a
# persistent volume here if durable files are required (pending infra approval).
# Hostinger/local: leave object storage unset — disk behavior is unchanged.
# UPLOADS_DIR=

# Cloudflare R2 (private bucket) — required on Vercel when VERCEL=1.
# Names only; set real values in the Vercel dashboard (never commit secrets).
# Bucket remains private; downloads stay behind authenticated /api/files routes.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=quickcheck-hub-files
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Vercel backend project env (names only; set in Vercel dashboard, never commit):
#   APP_RUNTIME_MODE=full
#   MONGO_URI=
#   JWT_SECRET=
#   GEMINI_API_KEY=
#   GEMINI_MODEL=
#   VAPID_SUBJECT=
#   VAPID_PUBLIC_KEY=
#   VAPID_PRIVATE_KEY=
#   CLIENT_ORIGIN=
#   RESEND_API_KEY=
#   PASSWORD_RESET_FROM_EMAIL=
#   PUBLIC_APP_URL=
#   ADMIN_NOTIFY_EMAIL=
#   R2_ACCOUNT_ID=
#   R2_ACCESS_KEY_ID=
#   R2_SECRET_ACCESS_KEY=
#   R2_BUCKET_NAME=quickcheck-hub-files
#   R2_ENDPOINT=
# Platform limits (Hobby): ~4.5MB request body, short function timeout —
# multipart uploads are capped near ~4MB on Vercel; large Hostinger uploads
# and multi-retry Gemini grading may need Pro maxDuration.

