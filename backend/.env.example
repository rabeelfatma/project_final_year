PORT=5000
# Local `npm start` defaults to maintenance unless this is exactly "full".
# Local `npm run dev` sets full mode via dev-start.js automatically.
# Vercel API project must set APP_RUNTIME_MODE=full. Hostinger is not a target.
APP_RUNTIME_MODE=full
MONGO_URI=mongodb://127.0.0.1:27017/quickcheckhub
JWT_SECRET=replace-with-your-own-secret
# Gemini AI grading (server-only). Set GEMINI_API_KEY in the Vercel API project env.
# GOOGLE_API_KEY is accepted as a fallback. Never expose keys to the frontend.
GEMINI_API_KEY=your-gemini-api-key
# Model id from Google AI Studio for your project (change if unavailable).
GEMINI_MODEL=gemini-3.8-flash
# Used only to identify your web-push application.
VAPID_SUBJECT=mailto:your-email@example.com
# Local: keys are auto-generated into backend/.vapid.json when missing.
# Vercel (read-only FS): set both explicitly — never rely on .vapid.json writes.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Extra browser origins, comma-separated. The production frontend origin
# https://quick-check-hub-frontend.vercel.app is allowed in code.
# Set CLIENT_ORIGIN only to add another exact origin (not a wildcard).
# CLIENT_ORIGIN=
# FRONTEND_URL=

# Transactional email via Resend (password reset + signup verification + Admin notify).
# All server-only — never expose to the React bundle / Vite client.
# Required trio for delivery: RESEND_API_KEY + PASSWORD_RESET_FROM_EMAIL + public URL.
# PUBLIC_APP_URL is preferred; FRONTEND_URL / first CLIENT_ORIGIN is an accepted fallback
# (see utils/publicAppUrl.js — used by transactionalEmail.js / passwordResetEmail.js).
# Leave RESEND_API_KEY or PASSWORD_RESET_FROM_EMAIL unset to fail closed
# (503 EMAIL_NOT_CONFIGURED) — no SMTP fallback.
# In production, an unset PUBLIC_APP_URL uses the Vercel frontend origin.
# An invalid explicit public URL still fails closed and is not replaced.
#
# Variable purposes:
#   RESEND_API_KEY              — Resend API secret (dashboard → API Keys). Never commit real values.
#   PASSWORD_RESET_FROM_EMAIL   — From header for all transactional mail. MUST be a sender/domain
#                                 already verified in Resend (e.g. QuickCheck Hub <noreply@your-domain>).
#   PUBLIC_APP_URL              — Public frontend origin used in verification + password-reset links.
#                                 Local Vite default port: http://localhost:5173
#   FRONTEND_URL / CLIENT_ORIGIN — Supported fallbacks when PUBLIC_APP_URL is unset (CLIENT_ORIGIN
#                                 may be comma-separated; non-localhost origins are preferred so
#                                 local CORS entries do not appear in phone verification emails).
#                                 In NODE_ENV=production, loopback, private-LAN, non-HTTPS,
#                                 the backend API host, and retired duke.com.pk values fail closed.
#                                 When unset in production, links use
#                                 https://quick-check-hub-frontend.vercel.app.
#
# Local development — set in backend/.env (NOT in Git):
#   RESEND_API_KEY=                          (paste from Resend dashboard; leave empty until ready)
#   PASSWORD_RESET_FROM_EMAIL=               (verified Resend sender only — do not invent)
#   PUBLIC_APP_URL=http://localhost:5173     (laptop browser email links)
#   Leave CLIENT_ORIGIN unset locally. Laptop localhost and private-LAN origins
#   are allowed outside production. Other websites are not.
#   ADMIN_NOTIFY_EMAIL=                      (optional; defaults in code if unset)
#
# Local mobile on same Wi-Fi (optional; do NOT commit the laptop IP):
#   1) Frontend: `npm run dev:lan` (or VITE_LAN=1) so Vite listens on LAN interfaces.
#   2) Open http://<laptop-private-ip>:5173 on the phone (same Wi-Fi; allow Windows Firewall).
#   3) For verification emails opened on the phone, temporarily set:
#        PUBLIC_APP_URL=http://<laptop-private-ip>:5173
#      Restore localhost (or omit) when finished. Never put a private IP into Vercel.
#
# Production email links use https://quick-check-hub-frontend.vercel.app when
# PUBLIC_APP_URL is unset. Do not set PUBLIC_APP_URL to the backend API host
# (https://quickcheck-hub-backend.vercel.app) or to duke.com.pk.
#
# Placeholders only (never real credentials in this file):
# RESEND_API_KEY=re_xxxxxxxx_replace_me
# PASSWORD_RESET_FROM_EMAIL=QuickCheck Hub <noreply@your-verified-domain>
# PUBLIC_APP_URL=http://localhost:5173
# ADMIN_NOTIFY_EMAIL=admin@example.com

# Academic upload storage root (optional). Default: backend/uploads.
# DB records keep relative paths like uploads/submissions/<file>.
# Local disk is the upload store when R2 is unset.
# Vercel has no durable local disk — set the R2 variables below on that project.
# UPLOADS_DIR=

# Cloudflare R2 (private bucket) — required on Vercel when VERCEL=1.
# Names only; set real values in the Vercel dashboard (never commit secrets).
# Bucket remains private; downloads stay behind authenticated /api/files routes.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=quickcheck-hub-files
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Vercel backend project env (names only; set in Vercel dashboard, never commit):
#   APP_RUNTIME_MODE=full
#   MONGO_URI=
#   JWT_SECRET=
#   GEMINI_API_KEY=
#   GEMINI_MODEL=
#   VAPID_SUBJECT=
#   VAPID_PUBLIC_KEY=
#   VAPID_PRIVATE_KEY=
#   CLIENT_ORIGIN=          ← optional extra exact origin. Production frontend is built in.
#   RESEND_API_KEY=         ← required before verification/reset email can send
#   PASSWORD_RESET_FROM_EMAIL=  ← required; must be a Resend-verified sender
#   PUBLIC_APP_URL=         ← optional. Default is https://quick-check-hub-frontend.vercel.app
#                             Never the backend host quickcheck-hub-backend.vercel.app
#   ADMIN_NOTIFY_EMAIL=
#   R2_ACCOUNT_ID=
#   R2_ACCESS_KEY_ID=
#   R2_SECRET_ACCESS_KEY=
#   R2_BUCKET_NAME=quickcheck-hub-files
#   R2_ENDPOINT=
# Platform limits (Hobby): ~4.5MB request body, short function timeout —
# multipart uploads are capped near ~4MB on Vercel; multi-retry Gemini grading
# may need Pro maxDuration.

